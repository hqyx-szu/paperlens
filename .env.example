APP_NAME=PaperLens
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# MySQL；请把 CHANGE_ME 替换为真实密码，本地 .env 不要提交到 Git
DATABASE_URL=mysql+asyncmy://paperlens:CHANGE_ME@127.0.0.1:3306/paperlens?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://paperlens:CHANGE_ME@127.0.0.1:3306/paperlens_test?charset=utf8mb4

# 登录会话
SESSION_COOKIE_NAME=paperlens_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# DeepSeek / LLM（不填 API Key 时 AI 接口返回 503 llm_unavailable）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_STEPS=4
LLM_MAX_OUTPUT_TOKENS=2048

# 论文 PDF 存储与处理
PAPER_STORAGE_DIR=var/papers
PAPER_PROCESSING_TIMEOUT_MINUTES=30
